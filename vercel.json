{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/p/:token",
      "destination": "/pt.html"
    },
    {
      "source": "/manifest.webmanifest",
      "has": [
        {
          "type": "host",
          "value": "parkingbay-ops.vercel.app"
        }
      ],
      "destination": "/manifest-airport-parking-bay.webmanifest"
    },
    {
      "source": "/manifest.webmanifest",
      "has": [
        {
          "type": "host",
          "value": "takeoff-ops.vercel.app"
        }
      ],
      "destination": "/manifest-takeoff.webmanifest"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest-default.webmanifest"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' blob: https://oioqjfrlwrjovnouhusp.supabase.co wss://oioqjfrlwrjovnouhusp.supabase.co; img-src 'self' data: blob: https://oioqjfrlwrjovnouhusp.supabase.co; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
